{
  "name": "@jrmc/face-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --release --manifest-path crates/face-napi/Cargo.toml --output-dir build --platform --esm -- --locked",
    "check:models": "node scripts/check-models.js",
    "test": "node --test tests/detection.test.js"
  },
  "napi": {
    "binaryName": "face-engine",
    "targets": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  }
}
