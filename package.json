{
  "name": "@jrmc/face-engine",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batosai/face-engine.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "imports": {
    "#native": "./build/index.js"
  },
  "files": [
    "build/index.js",
    "dist/src/index.js",
    "dist/src/index.d.ts",
    "dist/src/detection-worker.js",
    "dist/src/detection-worker.d.ts",
    "docs/usage.md",
    "licenses/models/",
    "profiles/yunet-sface.json"
  ],
  "scripts": {
    "build": "npm run build:native && tsc",
    "build:native": "napi build --release --manifest-path crates/face-napi/Cargo.toml --output-dir build --platform --esm -- --locked",
    "typecheck": "tsc --noEmit",
    "check:models": "node dist/scripts/check-models.js",
    "bench": "node dist/scripts/bench-photos.js",
    "pack:local": "node dist/scripts/pack-local.js",
    "compare": "node dist/scripts/compare-photos.js",
    "test": "node --test dist/tests/*.test.js"
  },
  "napi": {
    "binaryName": "face-engine",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
